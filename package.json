{
  "name": "ridemoa-static",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "node scripts/local-server.mjs",
    "prepare:dist": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-dist.ps1",
    "images:process": "node scripts/process-images.mjs",
    "images:r2": "node scripts/crawl-images-to-r2.mjs",
    "build:index": "node scripts/build-indexes.mjs && node scripts/build-metadata.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "build:figures": "node scripts/build-figures.mjs",
    "new:articles": "node scripts/write-articles.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.621.0",
    "cheerio": "^1.0.0",
    "sharp": "^0.33.5",
    "undici": "^6.19.8"
  },
  "devDependencies": {
    "serve": "^14.2.3"
  }
}
